# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB)
DATABASE_URL="mongodb://127.0.0.1:27017/voltrix_db"
# Example MongoDB Atlas Production:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/voltrix_db?retryWrites=true&w=majority"

# Authentication Secrets
JWT_SECRET="replace_with_a_random_jwt_secret"
ADMIN_JWT_SECRET="replace_with_a_different_random_admin_jwt_secret"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:5001/api"

# AI Provider Configuration (Gemini or OpenAI)
# If left empty, Voltrix AI uses its intelligent built-in semantic NLP tool executor
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="gemini" # or "openai"

# Payment Gateway (Optional / Staging)
RAZORPAY_KEY_ID="rzp_test_mock_voltrix"
RAZORPAY_KEY_SECRET="your_razorpay_test_or_live_secret"

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=""
